# Copy this file to .env and fill in your own values.

# Port the backend server runs on
PORT=3000

# Password to log into /admin.html (change this to something strong!)
ADMIN_PASSWORD=change-this-password

# A long random string used to sign admin login sessions.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Neon (used to permanently store orders + contact messages).
# Create a free database at https://neon.tech, run server/neon-schema.sql
# against it (Neon Console SQL Editor, or psql), then copy the connection
# string from the Neon dashboard (Connect -> pooled connection string).
# If left blank, the app falls back to local JSON files (fine for quick
# local testing, but NOT durable when deployed to Vercel).
DATABASE_URL=
